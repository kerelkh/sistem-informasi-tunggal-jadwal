# Copy to .env and fill in real values before running `docker compose up`.

# --- Postgres ---
POSTGRES_USER=situng
POSTGRES_PASSWORD=change-me
POSTGRES_DB=situng

# --- Backend ---
# Generate a real one, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-long-random-string
APP_NAME=SITUNG API

# --- Branding (frontend) ---
PUBLIC_APP_NAME=SITUNG
PUBLIC_APP_TAGLINE=Sistem Informasi Tunggal Jadwal
# The URL people open the app at. Set to the real domain in production
# (e.g. https://situng.example.go.id) — SvelteKit rejects form posts from other origins.
ORIGIN=http://localhost:3100

# --- Host ports ---
# Not 3000/4000, so SITUNG can run next to kerel.dev.
BACKEND_PORT=4100
FRONTEND_PORT=3100
