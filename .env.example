# Copy to .env and fill in real values before running `docker compose up`.
# POSTGRES_PASSWORD and JWT_SECRET_KEY are required — compose refuses to start without them.

# --- Postgres ---
POSTGRES_USER=situng
# It goes into a connection URL, so stick to letters and digits: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=situng

# --- Backend ---
# openssl rand -hex 32
JWT_SECRET_KEY=
APP_NAME=SITUNG API

# --- Branding (frontend) ---
PUBLIC_APP_NAME=SITUNG
PUBLIC_APP_TAGLINE=Sistem Informasi Tunggal Jadwal
# The URL people open the app at. Set to the real domain in production
# (e.g. https://situng.example.go.id) — SvelteKit rejects form posts from other origins.
ORIGIN=http://localhost:3100

# --- Reverse proxy ---
# Behind Coolify/Traefik/nginx set this to X-Forwarded-For, so login rate limiting is
# per visitor. Leave empty when the browser connects to the frontend directly.
ADDRESS_HEADER=

# --- Host ports (bound to 127.0.0.1 only) ---
# Not 3000/4000, so SITUNG can run next to kerel.dev.
BACKEND_PORT=4100
FRONTEND_PORT=3100
